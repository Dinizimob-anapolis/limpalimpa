# Postgres (Railway cria isso automaticamente ao adicionar o addon)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Anthropic (crie em console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Evolution API (o mesmo servidor que já roda a Diniz Imóveis)
EVOLUTION_API_URL=https://sua-evolution-api.up.railway.app
EVOLUTION_API_KEY=sua-api-key-global-do-evolution
EVOLUTION_INSTANCE=limpa-limpa

# Número que vai RECEBER o relatório diário (formato: 55DDDNUMERO, sem +)
REPORT_RECIPIENT_NUMBER=5562900000000

# Segurança do endpoint /dashboard (opcional, mesma ideia do diniz-leads-olx)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=troque-isso

# Fuso horário usado pro cron do relatório
TZ=America/Sao_Paulo
